    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "opentype.js": "1.3.4",
    "sharp": "0.35.4",
    "supabase": "2.117.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  }
