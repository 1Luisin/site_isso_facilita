# Sem segredo. Deixe vazio enquanto o domínio público não estiver definido.
# npm run dev usa http://localhost:3000 quando esta variável está vazia.
# No build, esta variável tem prioridade sobre VERCEL_PROJECT_PRODUCTION_URL.
# Na Vercel, pode ficar vazia: habilite o acesso às System Environment Variables.
# Fora da Vercel, informe uma origem HTTPS válida para o build, sem caminho.
# O valor é incorporado no build: alterá-lo exige gerar novamente o site.
NEXT_PUBLIC_SITE_URL=

# Measurement ID do GA4 (G-XXXXXXXXXX). Vazio ou inválido desativa analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
